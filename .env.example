# Neon Serverless PostgreSQL Connection Details
# Copy this file to .env or set these in your shell/IDE run configuration
NEON_DB_URL=jdbc:postgresql://ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=your_neon_password_here

# LLM Generation Provider (groq | gemini | openai | mock)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL_NAME=llama-3.3-70b-versatile

# Vector Embedding Provider (gemini | openai | mock)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
